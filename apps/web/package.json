{
  "name": "@visonaut/web",
  "version": "0.3.14",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:local": "vite build && node tooling/local-backend/run.mjs",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "wrangler types && tsc6 --noEmit && tsc6 --noEmit -p tooling/local-backend && tsc6 --noEmit -p tooling/capture-limit",
    "deploy": "pnpm build && wrangler deploy",
    "db:local": "wrangler d1 migrations apply DB --local --env production",
    "db:remote": "wrangler d1 migrations apply DB --remote --env production"
  },
  "dependencies": {
    "@ariakit/react": "0.4.43",
    "@ariakit/react-components": "0.7.2",
    "@ariakit/react-utils": "0.2.9",
    "@ariakit/tailwind": "0.2.10",
    "@ariakit/utils": "0.2.3",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.5",
    "@visonaut/compare": "workspace:*",
    "@visonaut/protocol": "workspace:*",
    "@visonaut/security": "workspace:*",
    "@visonaut/service": "workspace:*",
    "better-auth": "1.7.18",
    "clava": "0.7.2",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@cloudflare/workers-types": "5.20261110.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jose": "6.2.15",
    "miniflare": "5.20261104.0-beta",
    "tailwindcss": "4.3.5",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0",
    "wrangler": "4.158.0"
  }
}
