{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "visonaut-preview",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "preview.visonaut.com",
      "custom_domain": true,
      "zone_name": "visonaut.com",
    },
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
    },
  },
  "vars": {
    "VISONAUT_ENVIRONMENT": "preview",
    "VISONAUT_REPOSITORY": "ariakit/ariakit",
    "VISONAUT_LAUNCH_ENABLED": "false",
    "VISONAUT_ORIGIN": "https://preview.visonaut.com",
    "GITHUB_REPOSITORY_ID": "104133653",
    "VISONAUT_PROJECT_ID": "ariakit",
    "VISONAUT_API_LIMITS": "{\"maximumImageBytes\":2097152,\"maximumShardBytes\":536870912,\"maximumRunBytes\":2147483648,\"maximumStagedBytes\":8589934592,\"maximumManifestBytes\":16777216,\"maximumPlanBytes\":1500000,\"maximumCaptures\":40000,\"comparisonMaxAttempts\":5,\"databaseWarningBytes\":1610612736,\"databaseAdmissionBytes\":2147483648,\"maximumActiveRuns\":5}",
    "VISONAUT_OPERATIONS_BUDGET": "{\"tasksPerStep\":25,\"objectsPerStep\":1000,\"leaseMilliseconds\":720000,\"maxAttempts\":5,\"maximumObjectBytes\":16777216,\"maximumMetadataBytes\":2147483648,\"maximumExportEntries\":200000}",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "visonaut-preview",
      "database_id": "395b539c-c423-4ce4-887c-a5792792a63b",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "bucket_name": "visonaut-preview-images",
      "binding": "IMAGES",
    },
    {
      "bucket_name": "visonaut-preview-quarantine",
      "binding": "QUARANTINE",
    },
  ],
  "services": [
    {
      "binding": "COMPARATOR",
      "service": "visonaut-preview-compare",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "COMPARISONS",
        "queue": "visonaut-preview-comparisons",
      },
      {
        "binding": "OPERATIONS",
        "queue": "visonaut-preview-operations",
      },
    ],
    "consumers": [
      {
        "queue": "visonaut-preview-operations",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_concurrency": 1,
        "max_retries": 5,
        "dead_letter_queue": "visonaut-preview-dead-letter",
      },
    ],
  },
  "preview_urls": false,
  "limits": {
    "cpu_ms": 240000,
    "subrequests": 250000,
  },
  "triggers": {
    "crons": [],
  },
  "env": {
    "production": {
      "workers_dev": true,
      "routes": [{ "pattern": "visonaut.com", "custom_domain": true }],
      "vars": {
        "VISONAUT_ENVIRONMENT": "production",
        "VISONAUT_REPOSITORY": "ariakit/ariakit",
        "VISONAUT_LAUNCH_ENABLED": "false",
        "VISONAUT_ORIGIN": "https://visonaut.com",
        "GITHUB_CLIENT_ID": "Iv23lihLxwLZeW7tlh5u",
        "GITHUB_APP_ID": "5028451",
        "GITHUB_INSTALLATION_ID": "163661534",
        "GITHUB_REPOSITORY_ID": "104133653",
        "GITHUB_OWNER_ID": "40200111",
        "VISONAUT_PROJECT_ID": "ariakit",
        "VISONAUT_WORKFLOW_OWNED": "{\"callerWorkflowPath\":\".github/workflows/ci.yml\",\"trustedWorkflowPath\":\".github/workflows/app.yml\",\"submitJobName\":\"App / Visual Submit\",\"reusableWorkflowRef\":\"ariakit/ariakit/.github/workflows/app.yml@ec8ba1563228164856c33c94f4fa96645448c730\",\"reusableWorkflowSha\":\"ec8ba1563228164856c33c94f4fa96645448c730\",\"callerWorkflowBlobSha\":\"4b7a93772fcfe79479ece3395d5f6cb38922b52b\",\"captureJobName\":\"App / Visual Capture ({shard})\"}",
        "VISONAUT_TRUSTED_EXECUTOR_DIGEST": "7e8c77bf386518619fd2a04a8b5a1509fa5a1db1c2a84827b26132672999d3a5",
        "VISONAUT_ALLOW_MAIN_DISPATCH": "false",
        "VISONAUT_API_LIMITS": "{\"maximumImageBytes\":2097152,\"maximumShardBytes\":536870912,\"maximumRunBytes\":2147483648,\"maximumStagedBytes\":8589934592,\"maximumManifestBytes\":16777216,\"maximumPlanBytes\":1500000,\"maximumCaptures\":40000,\"comparisonMaxAttempts\":5,\"databaseWarningBytes\":1610612736,\"databaseAdmissionBytes\":2147483648,\"maximumActiveRuns\":5}",
        "VISONAUT_OPERATIONS_BUDGET": "{\"tasksPerStep\":25,\"objectsPerStep\":1000,\"leaseMilliseconds\":720000,\"maxAttempts\":5,\"maximumObjectBytes\":16777216,\"maximumMetadataBytes\":2147483648,\"maximumExportEntries\":200000}",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "visonaut-production",
          "database_id": "15fcd402-dccb-4359-a1ce-280ff67ca596",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        {
          "bucket_name": "visonaut-production-images",
          "binding": "IMAGES",
        },
        {
          "bucket_name": "visonaut-production-quarantine",
          "binding": "QUARANTINE",
        },
      ],
      "services": [
        {
          "binding": "COMPARATOR",
          "service": "visonaut-compare",
        },
      ],
      "queues": {
        "producers": [
          {
            "binding": "COMPARISONS",
            "queue": "visonaut-production-comparisons",
          },
          {
            "binding": "OPERATIONS",
            "queue": "visonaut-production-operations",
          },
        ],
        "consumers": [
          {
            "queue": "visonaut-production-operations",
            "max_batch_size": 1,
            "max_batch_timeout": 1,
            "max_concurrency": 1,
            "max_retries": 5,
            "dead_letter_queue": "visonaut-production-dead-letter",
          },
        ],
      },
      "triggers": {
        "crons": ["*/5 * * * *"],
      },
      "name": "visonaut",
      "secrets": {
        "required": [
          "BETTER_AUTH_SECRET",
          "CAPABILITY_SECRET",
          "GITHUB_CLIENT_SECRET",
          "GITHUB_APP_PRIVATE_KEY",
          "GITHUB_WEBHOOK_SECRET",
        ],
      },
    },
  },
  "secrets": { "required": [] },
}
