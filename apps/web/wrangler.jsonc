{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "visonaut-preview",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "preview.visonaut.com",
      "custom_domain": true,
      "zone_name": "visonaut.com",
    },
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
    },
  },
  "vars": {
    "VISONAUT_ENVIRONMENT": "preview",
    "VISONAUT_REPOSITORY": "ariakit/ariakit",
    "VISONAUT_LAUNCH_ENABLED": "false",
    "VISONAUT_ORIGIN": "https://preview.visonaut.com",
    "GITHUB_REPOSITORY_ID": "104133653",
    "VISONAUT_PROJECT_ID": "ariakit",
    "VISONAUT_API_LIMITS": "{}",
    "VISONAUT_OPERATIONS_BUDGET": "{}",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "visonaut-preview",
      "database_id": "395b539c-c423-4ce4-887c-a5792792a63b",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "bucket_name": "visonaut-preview-images",
      "binding": "IMAGES",
    },
    {
      "bucket_name": "visonaut-preview-quarantine",
      "binding": "QUARANTINE",
    },
  ],
  "services": [
    {
      "binding": "COMPARATOR",
      "service": "visonaut-preview-compare",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "OPERATIONS",
        "queue": "visonaut-preview-operations",
      },
    ],
    "consumers": [
      {
        "queue": "visonaut-preview-operations",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_concurrency": 1,
        "max_retries": 5,
        "dead_letter_queue": "visonaut-preview-dead-letter",
      },
    ],
  },
  "preview_urls": false,
  "limits": {
    "cpu_ms": 240000,
    "subrequests": 250000,
  },
  "triggers": {
    "crons": [],
  },
  "env": {
    "production": {
      "workers_dev": true,
      "routes": [{ "pattern": "visonaut.com", "custom_domain": true }],
      "vars": {
        "VISONAUT_ENVIRONMENT": "production",
        "VISONAUT_REPOSITORY": "ariakit/ariakit",
        "VISONAUT_LAUNCH_ENABLED": "true",
        "VISONAUT_ORIGIN": "https://visonaut.com",
        "GITHUB_CLIENT_ID": "Iv23lihLxwLZeW7tlh5u",
        "GITHUB_APP_ID": "5028451",
        "GITHUB_INSTALLATION_ID": "163661534",
        "GITHUB_REPOSITORY_ID": "104133653",
        "GITHUB_OWNER_ID": "40200111",
        "VISONAUT_PROJECT_ID": "ariakit",
        "VISONAUT_WORKFLOW_OWNED": "{\"callerWorkflowPath\":\".github/workflows/ci.yml\",\"trustedWorkflowPath\":\".github/workflows/app.yml\",\"submitJobName\":\"App / Visual Submit\",\"reusableWorkflowRef\":\"ariakit/ariakit/.github/workflows/app.yml@3858bc67dda6d70381c3ad189f85dd6266fc7942\",\"reusableWorkflowSha\":\"3858bc67dda6d70381c3ad189f85dd6266fc7942\",\"callerWorkflowBlobSha\":\"3dbaca30542ae9e84bbbba3f87cc29891bdf7856\",\"captureJobName\":\"App / Visual Capture ({shard})\"}",
        "VISONAUT_TRUSTED_EXECUTOR_DIGEST": "e1194e2085c15c99eb88ae59b638aaa0462b94233bffb4676fe7a2a60075ea98",
        "VISONAUT_ALLOW_MAIN_DISPATCH": "false",
        "VISONAUT_API_LIMITS": "{}",
        "VISONAUT_OPERATIONS_BUDGET": "{}",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "visonaut-production",
          "database_id": "15fcd402-dccb-4359-a1ce-280ff67ca596",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        {
          "bucket_name": "visonaut-production-images",
          "binding": "IMAGES",
        },
        {
          "bucket_name": "visonaut-production-quarantine",
          "binding": "QUARANTINE",
        },
      ],
      "services": [
        {
          "binding": "COMPARATOR",
          "service": "visonaut-compare",
        },
      ],
      "queues": {
        "producers": [
          {
            "binding": "OPERATIONS",
            "queue": "visonaut-production-operations",
          },
        ],
        "consumers": [
          {
            "queue": "visonaut-production-operations",
            "max_batch_size": 1,
            "max_batch_timeout": 1,
            "max_concurrency": 1,
            "max_retries": 5,
            "dead_letter_queue": "visonaut-production-dead-letter",
          },
        ],
      },
      "triggers": {
        "crons": ["*/5 * * * *"],
      },
      "name": "visonaut",
      "secrets": {
        "required": [
          "BETTER_AUTH_SECRET",
          "CAPABILITY_SECRET",
          "GITHUB_CLIENT_SECRET",
          "GITHUB_APP_PRIVATE_KEY",
          "GITHUB_WEBHOOK_SECRET",
        ],
      },
    },
  },
  "secrets": { "required": [] },
}
