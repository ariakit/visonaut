{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "visonaut-preview",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "preview.visonaut.com",
      "custom_domain": true,
      "zone_name": "visonaut.com",
    },
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
    },
  },
  "vars": {
    "VISONAUT_ENVIRONMENT": "preview",
    "VISONAUT_REPOSITORY": "ariakit/ariakit",
    "VISONAUT_LAUNCH_ENABLED": "false",
    "VISONAUT_ORIGIN": "https://preview.visonaut.com",
    "GITHUB_REPOSITORY_ID": "104133653",
    "VISONAUT_PROJECT_ID": "ariakit",
    "VISONAUT_API_LIMITS": "{}",
    "VISONAUT_OPERATIONS_BUDGET": "{}",
  },
  "d1_databases": [],
  "r2_buckets": [],
  "services": [],
  "queues": {
    "producers": [],
    "consumers": [],
  },
  "preview_urls": false,
  "limits": {
    "cpu_ms": 240000,
    "subrequests": 250000,
  },
  "triggers": {
    "crons": [],
  },
  "env": {
    "production": {
      "workers_dev": true,
      "routes": [{ "pattern": "visonaut.com", "custom_domain": true }],
      "vars": {
        "VISONAUT_ENVIRONMENT": "production",
        "VISONAUT_REPOSITORY": "ariakit/ariakit",
        "VISONAUT_LAUNCH_ENABLED": "true",
        "VISONAUT_ORIGIN": "https://visonaut.com",
        "GITHUB_CLIENT_ID": "Iv23lihLxwLZeW7tlh5u",
        "GITHUB_APP_ID": "5028451",
        "GITHUB_INSTALLATION_ID": "163661534",
        "GITHUB_REPOSITORY_ID": "104133653",
        "GITHUB_OWNER_ID": "40200111",
        "VISONAUT_PROJECT_ID": "ariakit",
        "VISONAUT_WORKFLOW_OWNED": "{\"callerWorkflowPath\":\".github/workflows/ci.yml\",\"trustedWorkflowPath\":\".github/workflows/app.yml\",\"submitJobName\":\"App / Visual Submit\",\"reusableWorkflowRef\":\"ariakit/ariakit/.github/workflows/app.yml@202fd63a37199f5ac4350bd7c4e4bc44ea442216\",\"reusableWorkflowSha\":\"202fd63a37199f5ac4350bd7c4e4bc44ea442216\",\"callerWorkflowBlobSha\":\"4d34ca17315b19fa90083501eb347ea23d88dda9\",\"captureJobName\":\"App / Visual Capture ({shard})\"}",
        "VISONAUT_TRUSTED_EXECUTOR_DIGEST": "be4439ac7ce5eccea7b0d253687cae53b114884deed179d9dd17fd966b722e22",
        "VISONAUT_ALLOW_MAIN_DISPATCH": "false",
        "VISONAUT_API_LIMITS": "{}",
        "VISONAUT_OPERATIONS_BUDGET": "{}",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "visonaut-production",
          "database_id": "441904d8-790b-44e3-9d83-a4c19e45c835",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        {
          "bucket_name": "visonaut-production-images",
          "binding": "IMAGES",
        },
        {
          "bucket_name": "visonaut-production-quarantine",
          "binding": "QUARANTINE",
        },
      ],
      "services": [
        {
          "binding": "COMPARATOR",
          "service": "visonaut-compare",
        },
      ],
      "queues": {
        "producers": [
          {
            "binding": "OPERATIONS",
            "queue": "visonaut-production-operations",
          },
        ],
        "consumers": [
          {
            "queue": "visonaut-production-operations",
            "max_batch_size": 1,
            "max_batch_timeout": 1,
            "max_concurrency": 1,
            "max_retries": 5,
            "dead_letter_queue": "visonaut-production-dead-letter",
          },
        ],
      },
      "triggers": {
        "crons": ["*/5 * * * *"],
      },
      "name": "visonaut",
      "secrets": {
        "required": [
          "BETTER_AUTH_SECRET",
          "CAPABILITY_SECRET",
          "GITHUB_CLIENT_SECRET",
          "GITHUB_APP_PRIVATE_KEY",
          "GITHUB_WEBHOOK_SECRET",
        ],
      },
    },
  },
  "secrets": { "required": [] },
}
