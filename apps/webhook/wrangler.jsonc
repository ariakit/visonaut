{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "visonaut-webhook",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-22",
  "workers_dev": false,
  "routes": [{ "pattern": "hooks.visonaut.com", "custom_domain": true }],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true },
  },
  "vars": {
    "VISONAUT_ARIAKIT_REPOSITORY_ID": "104133653",
    "VISONAUT_DIAGNOSTICS_REPOSITORY_ID": "1380792062",
    "VISONAUT_SERVICE_REPOSITORY_ID": "1380751023",
    "VISONAUT_PRODUCTION_ORIGIN": "https://visonaut.com",
    "VISONAUT_PREVIEW_ORIGIN": "https://preview.visonaut.com",
    "VISONAUT_DIAGNOSTICS_ORIGIN": "https://diagnostics.visonaut.com",
  },
  "services": [
    { "binding": "PRODUCTION", "service": "visonaut" },
    { "binding": "PREVIEW", "service": "visonaut-preview" },
    { "binding": "DIAGNOSTICS", "service": "visonaut-diagnostics" },
  ],
  "secrets": { "required": ["GITHUB_WEBHOOK_SECRET"] },
}
