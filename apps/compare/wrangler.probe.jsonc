{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "visonaut-codec-probe",
  "main": "src/probe.ts",
  "compatibility_date": "2026-09-21",
  "workers_dev": true,
  "observability": { "enabled": true, "traces": { "enabled": true } },
  "limits": { "cpu_ms": 30000 },
  "rules": [{ "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true }],
}
