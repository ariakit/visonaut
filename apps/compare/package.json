{
  "name": "@visonaut/compare-worker",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "wrangler types && tsc6 -p tsconfig.json",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --outdir dist",
    "probe": "wrangler dev --config wrangler.probe.jsonc",
    "probe:container": "wrangler dev --config wrangler.container-probe.jsonc",
    "typecheck:container": "wrangler types --config wrangler.container-probe.jsonc --env-interface ContainerProbeEnv container/worker-configuration.d.ts && tsc6 -p container/tsconfig.json"
  },
  "dependencies": {
    "@jsquash/png": "3.1.1",
    "@jsquash/webp": "1.5.0",
    "@visonaut/compare": "workspace:*",
    "@visonaut/service": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/containers": "0.3.7",
    "@cloudflare/workers-types": "5.20260922.1",
    "@types/node": "24.13.6",
    "miniflare": "5.20260921.0-alpha",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "5.0.1",
    "wrangler": "4.136.1"
  }
}
