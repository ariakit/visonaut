{
  "name": "@ariviso/compare-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "wrangler types && tsc6 -p tsconfig.json",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --outdir dist",
    "probe": "wrangler dev --config wrangler.probe.jsonc",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@ariviso/compare": "workspace:*",
    "@ariviso/service": "workspace:*",
    "@jsquash/png": "3.1.1",
    "@jsquash/webp": "1.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260922.1",
    "@types/node": "24.13.6",
    "miniflare": "5.20260921.0-alpha",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "5.0.1",
    "wrangler": "4.136.1"
  }
}
