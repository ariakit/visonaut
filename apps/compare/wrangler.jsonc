{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "visonaut-preview-compare",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-22",
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
    },
  },
  "limits": {
    "cpu_ms": 30000,
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": ["**/*.wasm"],
      "fallthrough": true,
    },
  ],
  // worker-only-v2 deletes the old namespace. Verify no active Container use before deployment.
  "migrations": [
    { "tag": "container-v1", "new_sqlite_classes": ["ComparisonContainer"] },
    { "tag": "worker-only-v2", "deleted_classes": ["ComparisonContainer"] },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "visonaut-preview",
      "database_id": "395b539c-c423-4ce4-887c-a5792792a63b",
    },
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "visonaut-preview-images",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "OPERATIONS",
        "queue": "visonaut-preview-operations",
      },
    ],
    "consumers": [],
  },
  "preview_urls": false,
  "env": {
    "production": {
      // Apply the same live-use gate before the production namespace deletion.
      "migrations": [
        { "tag": "container-v1", "new_sqlite_classes": ["ComparisonContainer"] },
        { "tag": "worker-only-v2", "deleted_classes": ["ComparisonContainer"] },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "visonaut-production-delta-20261004",
          "database_id": "f33b9393-cd04-4f7f-9213-428d1c3635b6",
        },
      ],
      "r2_buckets": [
        {
          "binding": "IMAGES",
          "bucket_name": "visonaut-production-images",
        },
      ],
      "queues": {
        "producers": [
          {
            "binding": "OPERATIONS",
            "queue": "visonaut-production-operations",
          },
        ],
        "consumers": [],
      },
      "name": "visonaut-compare",
    },
  },
}
