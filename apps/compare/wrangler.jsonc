{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "visonaut-compare-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-22",
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
    },
  },
  "limits": {
    "cpu_ms": 30000,
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": ["**/*.wasm"],
      "fallthrough": true,
    },
  ],
  "migrations": [],
  "preview_urls": false,
  "env": {
    "production": {
      // Apply the same live-use gate before the production namespace deletion.
      "migrations": [
        { "tag": "container-v1", "new_sqlite_classes": ["ComparisonContainer"] },
        { "tag": "worker-only-v2", "deleted_classes": ["ComparisonContainer"] },
      ],
      "name": "visonaut-compare",
    },
  },
}
