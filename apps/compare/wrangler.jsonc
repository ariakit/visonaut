{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "visonaut-compare-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-22",
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
    },
  },
  "limits": {
    "cpu_ms": 30000,
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": ["**/*.wasm"],
      "fallthrough": true,
    },
  ],
  "migrations": [],
  "d1_databases": [],
  "r2_buckets": [],
  "queues": {
    "producers": [],
    "consumers": [],
  },
  "preview_urls": false,
  "env": {
    "production": {
      // Apply the same live-use gate before the production namespace deletion.
      "migrations": [
        { "tag": "container-v1", "new_sqlite_classes": ["ComparisonContainer"] },
        { "tag": "worker-only-v2", "deleted_classes": ["ComparisonContainer"] },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "visonaut-production",
          "database_id": "441904d8-790b-44e3-9d83-a4c19e45c835",
        },
      ],
      "r2_buckets": [
        {
          "binding": "IMAGES",
          "bucket_name": "visonaut-production-images",
        },
      ],
      "queues": {
        "producers": [
          {
            "binding": "OPERATIONS",
            "queue": "visonaut-production-operations",
          },
        ],
        "consumers": [],
      },
      "name": "visonaut-compare",
    },
  },
}
