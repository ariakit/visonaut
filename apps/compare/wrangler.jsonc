{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "visonaut-preview-compare",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-22",
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
    },
  },
  "limits": {
    "cpu_ms": 30000,
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": ["**/*.wasm"],
      "fallthrough": true,
    },
  ],
  "vars": {
    "VISONAUT_COMPARISON_DEAD_LETTER_QUEUE": "visonaut-preview-comparison-dead-letter",
  },
  // worker-only-v2 deletes the old namespace. Verify no active Container use before deployment.
  "migrations": [
    { "tag": "container-v1", "new_sqlite_classes": ["ComparisonContainer"] },
    { "tag": "worker-only-v2", "deleted_classes": ["ComparisonContainer"] },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "visonaut-preview",
      "database_id": "395b539c-c423-4ce4-887c-a5792792a63b",
    },
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "visonaut-preview-images",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "COMPARISONS",
        "queue": "visonaut-preview-comparisons",
      },
      {
        "binding": "OPERATIONS",
        "queue": "visonaut-preview-operations",
      },
    ],
    "consumers": [
      {
        "queue": "visonaut-preview-comparisons",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_concurrency": 1,
        "max_retries": 10,
        "retry_delay": 60,
        "dead_letter_queue": "visonaut-preview-comparison-dead-letter",
      },
      {
        "queue": "visonaut-preview-comparison-dead-letter",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_concurrency": 1,
        "max_retries": 10,
        "retry_delay": 60,
      },
    ],
  },
  "preview_urls": false,
  "env": {
    "production": {
      "vars": {
        "VISONAUT_COMPARISON_DEAD_LETTER_QUEUE": "visonaut-production-comparison-dead-letter",
      },
      // Apply the same live-use gate before the production namespace deletion.
      "migrations": [
        { "tag": "container-v1", "new_sqlite_classes": ["ComparisonContainer"] },
        { "tag": "worker-only-v2", "deleted_classes": ["ComparisonContainer"] },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "visonaut-production",
          "database_id": "15fcd402-dccb-4359-a1ce-280ff67ca596",
        },
      ],
      "r2_buckets": [
        {
          "binding": "IMAGES",
          "bucket_name": "visonaut-production-images",
        },
      ],
      "queues": {
        "producers": [
          {
            "binding": "COMPARISONS",
            "queue": "visonaut-production-comparisons",
          },
          {
            "binding": "OPERATIONS",
            "queue": "visonaut-production-operations",
          },
        ],
        "consumers": [
          {
            "queue": "visonaut-production-comparisons",
            "max_batch_size": 1,
            "max_batch_timeout": 1,
            "max_concurrency": 5,
            "max_retries": 10,
            "retry_delay": 60,
            "dead_letter_queue": "visonaut-production-comparison-dead-letter",
          },
          {
            "queue": "visonaut-production-comparison-dead-letter",
            "max_batch_size": 1,
            "max_batch_timeout": 1,
            "max_concurrency": 1,
            "max_retries": 10,
            "retry_delay": 60,
          },
        ],
      },
      "name": "visonaut-compare",
    },
  },
}
