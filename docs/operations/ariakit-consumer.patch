+++ b/app/src/test-utils/visual-reporter.ts
@@ -0,0 +1,73 @@
+import path from "node:path";
+import { measureEnvironment } from "@visonaut/playwright/environment";
+import type { ReporterOptions } from "@visonaut/playwright/reporter";
+
+interface CreateVisualReporterParams {
+  shard: "linux" | "safari";
+  projects: string[];
+  appPackageFile: string;
+  repositoryRoot: string;
+  applicationFontPackage: string;
+  invocation: string[];
+}
+
+function requiredEnvironment(name: string) {
+  const value = process.env[name];
+  if (!value) {
+    throw new Error(`${name} is required for Visonaut capture`);
+  }
+  return value;
+}
+
+/** Keeps transport wiring local while page preparation stays in visual(). */
+export async function createVisualReporter({
+  shard,
+  projects,
+  appPackageFile,
+  repositoryRoot,
+  applicationFontPackage,
+  invocation,
+}: CreateVisualReporterParams) {
+  if (requiredEnvironment("VISONAUT_SHARD") !== shard) {
+    throw new Error("The visual project does not match its workflow shard");
+  }
+  const outputDirectory = path.join(
+    requiredEnvironment("RUNNER_TEMP"),
+    "visonaut",
+  );
+  const workflowAttempt = Number(requiredEnvironment("GITHUB_RUN_ATTEMPT"));
+  if (!Number.isSafeInteger(workflowAttempt) || workflowAttempt < 1) {
+    throw new Error("Visonaut capture needs a positive workflow attempt");
+  }
+  const measured = await measureEnvironment({
+    appPackageFile,
+    applicationFontPackage,
+    outputDirectory,
+  });
+  const packageDigest = requiredEnvironment("VISONAUT_PACKAGE_SHA256");
+  const reporter: ReporterOptions = {
+    outputFile: path.join(outputDirectory, "manifest.json"),
+    run: {
+      repository: requiredEnvironment("GITHUB_REPOSITORY"),
+      repositoryId: requiredEnvironment("GITHUB_REPOSITORY_ID"),
+      workflowRunId: requiredEnvironment("GITHUB_RUN_ID"),
+      workflowAttempt,
+      testedSha: requiredEnvironment("GITHUB_SHA"),
+      planDigest: packageDigest,
+    },
+    shard: {
+      key: shard,
+      // Candidate capture has no signed job identity. Submit replaces this
+      // placeholder only after GitHub proves the completed source job.
+      jobId: "1",
+      sourceAttempt: workflowAttempt,
+    },
+    discovery: {
+      executorDigest: packageDigest,
+      repositoryRoot,
+      expectedProjects: projects,
+      expectedInvocation: invocation,
+    },
+  };
+  return { reporter, metadata: { visonaut: { profile: measured.profile } } };
+}
