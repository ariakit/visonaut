diff --git a/.github/workflows/visual.yml b/.github/workflows/visual.yml
new file mode 100644
index 000000000..46d0794e6
--- /dev/null
+++ b/.github/workflows/visual.yml
@@ -0,0 +1,318 @@
+name: Visual
+
+on:
+  workflow_call:
+    inputs:
+      report-plan:
+        type: boolean
+        default: false
+
+    outputs:
+      main:
+        value: ${{ jobs.plan.outputs.main }}
+      app:
+        value: ${{ jobs.plan.outputs.app }}
+      perf:
+        value: ${{ jobs.plan.outputs.perf }}
+      plus:
+        value: ${{ jobs.plan.outputs.plus }}
+      release_preview:
+        value: ${{ jobs.plan.outputs.release_preview }}
+      docs:
+        value: ${{ jobs.plan.outputs.docs }}
+      og_images:
+        value: ${{ jobs.plan.outputs.og_images }}
+      plan:
+        value: ${{ jobs.plan.outputs.plan }}
+
+permissions:
+  contents: read
+
+env:
+  VISONAUT_SERVER: https://visonaut.com
+  VISONAUT_PACKAGE_VERSION: 0.4.0
+  VISONAUT_ADAPTER_PACKAGE_VERSION: 0.4.0
+  VISONAUT_PACKAGE_SHA256: PENDING_RELEASE_SHA256
+  VISONAUT_CAPTURE_JOB_PREFIX: "App / Visual / Capture / "
+  VISONAUT_SUBMIT_JOB_NAME: "App / Visual / Submit"
+
+jobs:
+  plan:
+    name: Plan
+    if: inputs.report-plan
+    runs-on: ubuntu-latest
+    timeout-minutes: 5
+    outputs:
+      main: ${{ steps.plan.outputs.main }}
+      app: ${{ steps.plan.outputs.app }}
+      perf: ${{ steps.plan.outputs.perf }}
+      plus: ${{ steps.plan.outputs.plus }}
+      release_preview: ${{ steps.plan.outputs.release_preview }}
+      docs: ${{ steps.plan.outputs.docs }}
+      og_images: ${{ steps.plan.outputs.og_images }}
+      plan: ${{ steps.plan.outputs.plan }}
+    steps:
+      - name: Checkout trusted planner
+        uses: actions/checkout@v7
+        with:
+          ref: main
+          fetch-depth: 0
+          persist-credentials: false
+
+      - name: Set up Node
+        uses: actions/setup-node@v7
+        with:
+          node-version-file: package.json
+
+      - name: Fetch tested commits
+        if: github.event_name == 'pull_request'
+        env:
+          BASE_SHA: ${{ github.event.pull_request.base.sha }}
+          HEAD_SHA: ${{ github.event.pull_request.head.sha }}
+        shell: bash
+        run: |
+          set -euo pipefail
+          [[ "$BASE_SHA" =~ ^[a-f0-9]{40}$ ]]
+          [[ "$HEAD_SHA" =~ ^[a-f0-9]{40}$ ]]
+          git fetch --no-tags origin "$BASE_SHA" "$HEAD_SHA"
+
+      - name: Calculate trusted Plan
+        id: plan
+        env:
+          BASE_SHA: ${{ github.event.pull_request.base.sha }}
+          HEAD_SHA: ${{ github.event.pull_request.head.sha }}
+          BASE_REF: ${{ github.event.pull_request.base.ref }}
+        run: |
+          if [ "$GITHUB_EVENT_NAME" = "push" ]; then
+            node --input-type=module <<'NODE_MAIN_PLAN'
+          import { appendFileSync } from "node:fs";
+          if (process.env.GITHUB_REF !== "refs/heads/main") {
+            throw new Error("The main Plan requires the main branch");
+          }
+          // Preserve the existing main App pipeline with an explicit Plan.
+          const workflows = {
+            main: false,
+            app: true,
+            perf: false,
+            plus: false,
+            release_preview: false,
+            docs: false,
+            og_images: false,
+          };
+          for (const [name, selected] of Object.entries(workflows)) {
+            appendFileSync(process.env.GITHUB_OUTPUT, `${name}=${selected}\n`);
+          }
+          appendFileSync(process.env.GITHUB_OUTPUT,
+            `plan=${JSON.stringify({version: 1, workflows})}\n`);
+          NODE_MAIN_PLAN
+          else
+            node packages/ariakit-scripts/src/ci-run.ts plan
+          fi
+
+  report:
+    name: Report
+    needs: plan
+    if: inputs.report-plan
+    runs-on: ubuntu-latest
+    timeout-minutes: 5
+    permissions:
+      contents: read
+      id-token: write
+    steps:
+      - name: Set up Node
+        uses: actions/setup-node@v7
+        with:
+          node-version: "24.18.0"
+
+      - name: Report trusted Plan
+        env:
+          VISUAL_REQUIRED: ${{ needs.plan.outputs.app }}
+        run: |
+          node --input-type=module <<'NODE'
+          const origin = process.env.VISONAUT_SERVER;
+          const actual = process.env.VISUAL_REQUIRED;
+          if (actual !== "true" && actual !== "false") {
+            throw new Error("The trusted Plan did not produce a visual decision");
+          }
+          const tokenURL = new URL(process.env.ACTIONS_ID_TOKEN_REQUEST_URL);
+          tokenURL.searchParams.set("audience", `${origin}/plan-report`);
+          const tokenResponse = await fetch(tokenURL, {
+            headers: { Authorization: `Bearer ${process.env.ACTIONS_ID_TOKEN_REQUEST_TOKEN}` },
+            redirect: "error",
+            signal: AbortSignal.timeout(30_000),
+          });
+          if (!tokenResponse.ok) {
+            throw new Error("GitHub could not issue the Plan identity token");
+          }
+          const identity = await tokenResponse.json();
+          if (typeof identity.value !== "string" || !identity.value) {
+            throw new Error("GitHub returned an invalid Plan identity token");
+          }
+          const payload = {
+            schemaVersion: 1,
+            workflowRunId: process.env.GITHUB_RUN_ID,
+            workflowAttempt: Number(process.env.GITHUB_RUN_ATTEMPT),
+            testedSha: process.env.GITHUB_SHA,
+            visualRequired: actual === "true",
+            planResult: "success",
+          };
+          for (let attempt = 0; attempt < 3; attempt++) {
+            const response = await fetch(`${origin}/v1/plan`, {
+              method: "POST",
+              headers: {
+                Authorization: `Bearer ${identity.value}`,
+                "Content-Type": "application/json",
+              },
+              body: JSON.stringify(payload),
+              redirect: "error",
+              signal: AbortSignal.timeout(30_000),
+            });
+            await response.body?.cancel();
+            if (response.ok) break;
+            if (attempt === 2 || ![429, 502, 503, 504].includes(response.status)) {
+              throw new Error(`Visonaut rejected the trusted Plan (HTTP ${response.status})`);
+            }
+            await new Promise((resolve) => setTimeout(resolve, (attempt + 1) * 1000));
+          }
+          console.log("Visonaut recorded the trusted Plan.");
+          NODE
+
+  capture:
+    if: ${{ !inputs.report-plan }}
+    name: Capture / ${{ matrix.shard }}
+    runs-on: ${{ matrix.os }}
+    timeout-minutes: 120
+    permissions:
+      contents: read
+    strategy:
+      fail-fast: false
+      matrix:
+        include:
+          - os: ubuntu-latest
+            shard: linux
+            engines: chromium firefox
+            projects: chrome firefox
+            test: xvfb-run pnpm -F app run test-visual
+          - os: macos-latest
+            shard: safari
+            engines: webkit
+            projects: safari
+            test: pnpm -F app run test-visual
+    env:
+      VISONAUT_SHARD: ${{ matrix.shard }}
+    steps:
+      - name: Checkout repository
+        uses: actions/checkout@v7
+        with:
+          persist-credentials: false
+
+      - name: Set up environment
+        uses: ./.github/workflows/setup
+        with:
+          filters: |
+            app...
+            root
+
+      - name: Verify capture package
+        run: |
+          [[ "$VISONAUT_PACKAGE_SHA256" =~ ^[a-f0-9]{64}$ ]] || {
+            echo "Set the reviewed CLI release digest before this workflow runs."
+            exit 1
+          }
+          pnpm -F app exec node --input-type=module <<'NODE_ADAPTER_VERSION'
+          import { readFile } from "node:fs/promises";
+          const entry = import.meta.resolve("@visonaut/playwright");
+          const manifest = JSON.parse(await readFile(new URL("../package.json", entry), "utf8"));
+          if (manifest.version !== process.env.VISONAUT_ADAPTER_PACKAGE_VERSION) {
+            throw new Error("Install the pinned Visonaut adapter and refresh the lockfile before capture");
+          }
+          NODE_ADAPTER_VERSION
+
+      - name: Install Playwright
+        uses: ./.github/workflows/install-playwright
+        with:
+          engines: ${{ matrix.engines }}
+          workspace: app
+
+      - name: Download app artifact
+        uses: actions/download-artifact@v8
+        with:
+          name: app-build
+          path: app
+
+      - name: Download Next.js artifact
+        uses: actions/download-artifact@v8
+        with:
+          name: nextjs-dist
+          path: nextjs/.open-next
+
+      - name: Test visual
+        run: ${{ matrix.test }} --project ${{ matrix.projects }} --grep @visual --output test-results/test-visual
+
+      - name: Upload captures
+        uses: actions/upload-artifact@v7
+        with:
+          name: visonaut-capture-${{ github.run_id }}-${{ github.run_attempt }}-${{ matrix.shard }}
+          path: ${{ runner.temp }}/visonaut
+          if-no-files-found: error
+          retention-days: 1
+
+      - name: Upload diagnostics
+        if: ${{ !cancelled() }}
+        uses: actions/upload-artifact@v7
+        with:
+          name: app-visual-${{ matrix.shard }}-test-results
+          path: app/test-results
+          if-no-files-found: ignore
+          retention-days: 7
+
+  submit:
+    if: ${{ !inputs.report-plan }}
+    name: Submit
+    needs: capture
+    runs-on: ubuntu-latest
+    timeout-minutes: 30
+    permissions:
+      actions: read
+      contents: read
+      id-token: write
+    env:
+      GH_TOKEN: ${{ github.token }}
+      VISONAUT_WORKFLOW_SOURCE_SHA: ${{ vars.VISONAUT_WORKFLOW_SOURCE_SHA }}
+    steps:
+      - name: Checkout trusted toolchain
+        uses: actions/checkout@v7
+        with:
+          ref: main
+          persist-credentials: false
+
+      - name: Set up environment
+        uses: ./.github/workflows/setup
+        with:
+          install: "false"
+
+      - name: Install Visonaut
+        run: |
+          set -euo pipefail
+          mkdir -p "$RUNNER_TEMP/visonaut-tools"
+          [[ "$VISONAUT_PACKAGE_VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]
+          [[ "$VISONAUT_PACKAGE_SHA256" =~ ^[a-f0-9]{64}$ ]]
+          archive="$RUNNER_TEMP/visonaut-$VISONAUT_PACKAGE_VERSION.tgz"
+          curl --fail --silent --show-error --proto '=https' --max-time 60 \
+            --max-filesize 16777216 --output "$archive" \
+            "https://registry.npmjs.org/visonaut/-/visonaut-$VISONAUT_PACKAGE_VERSION.tgz"
+          printf '%s  %s\n' "$VISONAUT_PACKAGE_SHA256" "$archive" | sha256sum --check --strict -
+          pnpm --dir "$RUNNER_TEMP/visonaut-tools" add --ignore-scripts --save-exact "$archive"
+          echo "$RUNNER_TEMP/visonaut-tools/node_modules/.bin" >> "$GITHUB_PATH"
+
+      - name: Submit verified captures
+        id: submit
+        run: visonaut submit --shard linux --shard safari
+
+      - name: Upload receipt
+        uses: actions/upload-artifact@v7
+        with:
+          name: ${{ steps.submit.outputs.name }}
+          path: ${{ steps.submit.outputs.path }}
+          if-no-files-found: error
+          retention-days: 1
