index 000000000..3ef29c92a
--- /dev/null
+++ b/scripts/visonaut-workflow.test.ts
@@ -0,0 +1,352 @@
+import { execFileSync, spawnSync } from "node:child_process";
+import { createHash } from "node:crypto";
+import {
+  existsSync,
+  mkdirSync,
+  mkdtempSync,
+  readFileSync,
+  rmSync,
+  writeFileSync,
+} from "node:fs";
+import { tmpdir } from "node:os";
+import path from "node:path";
+import { runInNewContext } from "node:vm";
+import { gzipSync } from "node:zlib";
+import { expect, test, vi } from "vitest";
+
+const workflow = readFileSync(".github/workflows/visual.yml", "utf8");
+const script = workflow.match(
+  /node --input-type=module <<'NODE'\n([\s\S]*?)\n\s+NODE/,
+)?.[1];
+if (!script) {
+  throw new Error("The visual workflow must contain the trusted Plan report");
+}
+
+interface ExecuteReportParams {
+  actual?: string;
+  statuses?: number[];
+  token?: unknown;
+}
+
+function executeReport({
+  actual = "false",
+  statuses = [200],
+  token = "identity-token",
+}: ExecuteReportParams = {}) {
+  const requests: { url: string; body: string }[] = [];
+  const fetch = vi.fn(async (url: string | URL, options: RequestInit = {}) => {
+    if (requests.length === 0) {
+      requests.push({ url: String(url), body: "" });
+      return Response.json({ value: token });
+    }
+    if (typeof options.body !== "string") {
+      throw new Error("The Plan body must be serialized JSON");
+    }
+    requests.push({ url: String(url), body: options.body });
+    return new Response(null, {
+      status: statuses[requests.length - 2] ?? 200,
+    });
+  });
+  const result = runInNewContext(`(async () => {\n${script}\n})()`, {
+    process: {
+      env: {
+        VISONAUT_SERVER: "https://visonaut.com",
+        VISUAL_REQUIRED: actual,
+        ACTIONS_ID_TOKEN_REQUEST_URL:
+          "https://token.actions.githubusercontent.com/token",
+        ACTIONS_ID_TOKEN_REQUEST_TOKEN: "request-token",
+        GITHUB_RUN_ID: "123",
+        GITHUB_RUN_ATTEMPT: "2",
+        GITHUB_SHA: "a".repeat(40),
+      },
+    },
+    URL,
+    AbortSignal,
+    fetch,
+    console: { log: vi.fn() },
+    setTimeout: (callback: () => void) => callback(),
+  });
+  return { result, requests, fetch };
+}
+
+test.each(["true", "false"])(
+  "reports the independently verified %s Plan",
+  async (actual) => {
+    const report = executeReport({ actual });
+    await report.result;
+    expect(report.requests).toEqual([
+      {
+        url: "https://token.actions.githubusercontent.com/token?audience=https%3A%2F%2Fvisonaut.com%2Fplan-report",
+        body: "",
+      },
+      {
+        url: "https://visonaut.com/v1/plan",
+        body: JSON.stringify({
+          schemaVersion: 1,
+          workflowRunId: "123",
+          workflowAttempt: 2,
+          testedSha: "a".repeat(40),
+          visualRequired: actual === "true",
+          planResult: "success",
+        }),
+      },
+    ]);
+  },
+);
+
+test.each(["", "unknown", "False", "null"])(
+  "rejects absent or invalid trusted Plan output before identity exchange: %j",
+  async (actual) => {
+    const report = executeReport({ actual });
+    await expect(report.result).rejects.toThrow(/Plan/);
+    expect(report.fetch).not.toHaveBeenCalled();
+  },
+);
+
+test("retries transient delivery without changing the Plan", async () => {
+  const report = executeReport({ statuses: [503, 429, 200] });
+  await report.result;
+  expect(report.requests).toHaveLength(4);
+  expect(
+    new Set(report.requests.slice(1).map((request) => request.body)).size,
+  ).toBe(1);
+});
+
+test.each([{ statuses: [503, 503, 503] }, { statuses: [403] }])(
+  "fails closed on undeliverable Plan reports: %j",
+  async ({ statuses }) => {
+    const report = executeReport({ statuses });
+    await expect(report.result).rejects.toThrow(
+      "Visonaut rejected the trusted Plan",
+    );
+    expect(report.requests).toHaveLength(statuses.length + 1);
+  },
+);
+
+test("rejects an invalid identity token before delivery", async () => {
+  const report = executeReport({ token: false });
+  await expect(report.result).rejects.toThrow("invalid Plan identity token");
+  expect(report.requests).toHaveLength(1);
+});
+
+const mainPlanScript = workflow.match(
+  /node --input-type=module <<'NODE_MAIN_PLAN'\n([\s\S]*?)\n\s+NODE_MAIN_PLAN/,
+)?.[1];
+const adapterVersionScript = workflow.match(
+  /node --input-type=module <<'NODE_ADAPTER_VERSION'\n([\s\S]*?)\n\s+NODE_ADAPTER_VERSION/,
+)?.[1];
+if (!mainPlanScript || !adapterVersionScript) {
+  throw new Error(
+    "The workflow must define a main Plan and adapter version gate",
+  );
+}
+
+test("the actual main Plan preserves the App-only pipeline", () => {
+  const directory = mkdtempSync(path.join(tmpdir(), "visonaut-main-plan-"));
+  const output = path.join(directory, "outputs");
+  try {
+    execFileSync(
+      process.execPath,
+      ["--input-type=module", "-e", mainPlanScript],
+      {
+        env: {
+          ...process.env,
+          GITHUB_REF: "refs/heads/main",
+          GITHUB_OUTPUT: output,
+        },
+        stdio: "pipe",
+        timeout: 5000,
+      },
+    );
+    const values = Object.fromEntries(
+      readFileSync(output, "utf8")
+        .trim()
+        .split("\n")
+        .map((line) => {
+          const separator = line.indexOf("=");
+          return [line.slice(0, separator), line.slice(separator + 1)];
+        }),
+    );
+    expect(values).toEqual({
+      main: "false",
+      app: "true",
+      perf: "false",
+      plus: "false",
+      release_preview: "false",
+      docs: "false",
+      og_images: "false",
+      plan: JSON.stringify({
+        version: 1,
+        workflows: {
+          main: false,
+          app: true,
+          perf: false,
+          plus: false,
+          release_preview: false,
+          docs: false,
+          og_images: false,
+        },
+      }),
+    });
+  } finally {
+    rmSync(directory, { recursive: true, force: true });
+  }
+});
+
+test("the main Plan cannot run on another branch", () => {
+  expect(() =>
+    execFileSync(
+      process.execPath,
+      ["--input-type=module", "-e", mainPlanScript],
+      {
+        env: { ...process.env, GITHUB_REF: "refs/heads/untrusted" },
+        stdio: "pipe",
+        timeout: 5000,
+      },
+    ),
+  ).toThrow("The main Plan requires the main branch");
+});
+
+test("the capture package gate rejects an unexpected installed adapter", () => {
+  expect(() =>
+    execFileSync(
+      process.execPath,
+      ["--input-type=module", "-e", adapterVersionScript],
+      {
+        cwd: path.resolve("app"),
+        env: { ...process.env, VISONAUT_ADAPTER_PACKAGE_VERSION: "0.0.0" },
+        stdio: "pipe",
+        timeout: 5000,
+      },
+    ),
+  ).toThrow("Install the pinned Visonaut adapter");
+});
+
+const installStep = workflow.match(
+  /      - name: Install Visonaut\n        run: \|\n([\s\S]*?)\n      - name: Submit verified captures/,
+)?.[1];
+if (!installStep) {
+  throw new Error("The workflow must define the signed package installer");
+}
+const installScript = installStep.replace(/^          /gm, "");
+
+function executePackageInstall(altered = false) {
+  const directory = mkdtempSync(
+    path.join(tmpdir(), "visonaut-package-install-"),
+  );
+  const bin = path.join(directory, "bin");
+  const archive = path.join(directory, "fixture.tgz");
+  const downloadLog = path.join(directory, "download.log");
+  const installLog = path.join(directory, "install.log");
+  const githubPath = path.join(directory, "github-path");
+  const candidate = process.env.VISONAUT_TEST_PACKAGE_ARCHIVE;
+  const bytes = candidate
+    ? readFileSync(candidate)
+    : gzipSync(Buffer.alloc(1024));
+  const expectedDigest = createHash("sha256").update(bytes).digest("hex");
+  const first = bytes[0];
+  if (first === undefined) {
+    throw new Error("The package fixture cannot be empty");
+  }
+  if (altered) {
+    bytes[0] = first ^ 1;
+  }
+  try {
+    mkdirSync(bin);
+    writeFileSync(archive, bytes);
+    writeFileSync(
+      path.join(bin, "curl"),
+      [
+        "#!/bin/bash",
+        "set -eu",
+        'printf "%s\\n" "$@" > "$VISONAUT_DOWNLOAD_LOG"',
+        'output=""',
+        'while [[ "$#" -gt 0 ]]; do',
+        '  if [[ "$1" == "--output" ]]; then',
+        '    output="$2"',
+        "    shift 2",
+        "  else",
+        "    shift",
+        "  fi",
+        "done",
+        'cp "$VISONAUT_DOWNLOAD_FIXTURE" "$output"',
+      ].join("\n"),
+      { mode: 0o755 },
+    );
+    writeFileSync(
+      path.join(bin, "pnpm"),
+      '#!/bin/bash\nset -eu\nprintf "%s\\n" "$@" > "$VISONAUT_INSTALL_LOG"\n',
+      { mode: 0o755 },
+    );
+    const result = spawnSync("bash", ["-c", installScript], {
+      env: {
+        ...process.env,
+        PATH: `${bin}${path.delimiter}${process.env.PATH}`,
+        RUNNER_TEMP: directory,
+        GITHUB_PATH: githubPath,
+        VISONAUT_PACKAGE_VERSION: "0.4.0",
+        VISONAUT_PACKAGE_SHA256: expectedDigest,
+        VISONAUT_DOWNLOAD_FIXTURE: archive,
+        VISONAUT_DOWNLOAD_LOG: downloadLog,
+        VISONAUT_INSTALL_LOG: installLog,
+      },
+      encoding: "utf8",
+      timeout: 5000,
+    });
+    return {
+      result,
+      directory,
+      downloaded: existsSync(downloadLog)
+        ? readFileSync(downloadLog, "utf8").trim().split("\n")
+        : undefined,
+      installed: existsSync(installLog)
+        ? readFileSync(installLog, "utf8").trim().split("\n")
+        : undefined,
+      githubPath: existsSync(githubPath)
+        ? readFileSync(githubPath, "utf8").trim()
+        : undefined,
+    };
+  } finally {
+    rmSync(directory, { recursive: true, force: true });
+  }
+}
+
+test("the signed installer installs only the verified local archive", () => {
+  const install = executePackageInstall();
+  expect(install.result.error).toBeUndefined();
+  expect(install.result.status).toBe(0);
+  expect(install.downloaded).toEqual([
+    "--fail",
+    "--silent",
+    "--show-error",
+    "--proto",
+    "=https",
+    "--max-time",
+    "60",
+    "--max-filesize",
+    "16777216",
+    "--output",
+    path.join(install.directory, "visonaut-0.4.0.tgz"),
+    "https://registry.npmjs.org/visonaut/-/visonaut-0.4.0.tgz",
+  ]);
+  expect(install.installed).toEqual([
+    "--dir",
+    path.join(install.directory, "visonaut-tools"),
+    "add",
+    "--ignore-scripts",
+    "--save-exact",
+    path.join(install.directory, "visonaut-0.4.0.tgz"),
+  ]);
+  expect(install.githubPath).toBe(
+    path.join(install.directory, "visonaut-tools/node_modules/.bin"),
+  );
+});
+
+test("the signed installer rejects an altered archive before installation", () => {
+  const install = executePackageInstall(true);
+  expect(install.result.error).toBeUndefined();
+  expect(install.result.status).not.toBe(0);
+  expect(install.result.stdout).toContain("FAILED");
+  expect(install.installed).toBeUndefined();
+  expect(install.githubPath).toBeUndefined();
+});
