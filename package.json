{
  "name": "visonaut-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @visonaut/web dev",
    "dev:local": "pnpm --filter @visonaut/web dev:local",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:browser": "playwright test --config apps/web/src/review/__tests__/playwright.config.ts",
    "lint": "oxlint && oxfmt --check",
    "format": "oxfmt",
    "check": "pnpm lint && pnpm typecheck && pnpm build && pnpm test && pnpm test:browser",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only --ignore-scripts",
    "test:release-guards": "node --test .github/workflows/scripts/*.test.mjs",
    "check:ariakit-ui": "node tooling/ariakit-ui-copy.ts --check",
    "check:packages": "node .github/workflows/scripts/packages.mjs"
  },
  "devDependencies": {
    "@changesets/apply-release-plan": "8.1.1",
    "@changesets/cli": "3.0.3",
    "@changesets/types": "7.0.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "lefthook": "2.2.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "tsup": "9.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "5.0.4",
    "wrangler": "4.151.3"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.15.0"
}
