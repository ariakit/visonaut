{
  "name": "visonaut-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @visonaut/web dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:browser": "playwright test --config apps/web/src/review/__tests__/playwright.config.ts",
    "lint": "oxlint && oxfmt --check",
    "format": "oxfmt",
    "check": "pnpm lint && pnpm typecheck && pnpm build && pnpm test && pnpm test:browser",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "lefthook": "2.1.14",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "tsup": "8.5.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "5.0.1",
    "wrangler": "4.136.1"
  },
  "engines": {
    "node": "24.18.0"
  },
  "packageManager": "pnpm@12.5.1"
}
