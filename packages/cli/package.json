{
  "name": "visonaut",
  "version": "0.2.0",
  "description": "Upload visual captures and inspect Visonaut review status",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ariakit/visonaut",
    "directory": "packages/cli"
  },
  "bin": {
    "visonaut": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc6 --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@visonaut/protocol": "workspace:*",
    "tsup": "8.5.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=24.18.0 <25"
  }
}
